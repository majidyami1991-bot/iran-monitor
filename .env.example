# ====================================================
# تنظیمات سامانه Iran Monitor
# ====================================================

# پایگاه داده PostgreSQL
POSTGRES_DB=iran_monitor
POSTGRES_USER=iran_monitor_user
POSTGRES_PASSWORD=iran_monitor_secret_123
POSTGRES_PORT=5433

# سرویس بک‌اند (FastAPI)
BACKEND_PORT=8000

# سرویس فرانت‌اند (Next.js)
FRONTEND_PORT=3000

# سرویس جمع‌آوری‌کننده اخبار (Collector Scheduler)
NEWS_COLLECTION_ENABLED=true
NEWS_COLLECTION_INTERVAL_SECONDS=900
