# Never commit .env. Generate secrets locally; never log them.
# *_ID and OPENCTI_ADMIN_TOKEN require distinct UUIDv4 values.
# HOST, PORT and EXTERNAL_SCHEME control the web address.
# All GENERATE_SECRET values require cryptographically secure random values.
MINIO_ROOT_USER=GENERATE_SECRET
MINIO_ROOT_PASSWORD=GENERATE_SECRET
RABBITMQ_DEFAULT_USER=GENERATE_SECRET
RABBITMQ_DEFAULT_PASS=GENERATE_SECRET
SMTP_HOSTNAME=localhost
OPENSEARCH_ADMIN_PASSWORD=GENERATE_SECRET
ELASTIC_MEMORY_SIZE=4G
XTM_COMPOSER_ID=GENERATE_UUIDV4
COMPOSE_PROJECT_NAME=iran-monitor-opencti
OPENCTI_HOST=localhost
OPENCTI_PORT=8080
OPENCTI_EXTERNAL_SCHEME=http
OPENCTI_ADMIN_EMAIL=admin@iran-monitor.local
OPENCTI_ADMIN_PASSWORD=GENERATE_SECRET
OPENCTI_ADMIN_TOKEN=GENERATE_UUIDV4
OPENCTI_HEALTHCHECK_ACCESS_KEY=GENERATE_SECRET
CONNECTOR_EXPORT_FILE_STIX_ID=GENERATE_UUIDV4
CONNECTOR_EXPORT_FILE_CSV_ID=GENERATE_UUIDV4
CONNECTOR_EXPORT_FILE_TXT_ID=GENERATE_UUIDV4
CONNECTOR_IMPORT_FILE_STIX_ID=GENERATE_UUIDV4
CONNECTOR_IMPORT_DOCUMENT_ID=GENERATE_UUIDV4
CONNECTOR_IMPORT_FILE_YARA_ID=GENERATE_UUIDV4
CONNECTOR_IMPORT_EXTERNAL_REFERENCE_ID=GENERATE_UUIDV4
CONNECTOR_ANALYSIS_ID=GENERATE_UUIDV4
CONNECTOR_OPENCTI_ID=GENERATE_UUIDV4
CONNECTOR_MITRE_ID=GENERATE_UUIDV4
# Base64-encoded cryptographic 32-byte encryption key; generate locally.
OPENCTI_ENCRYPTION_KEY=GENERATE_BASE64_32_BYTES

# --- News monitor -----------------------------------------------------------
NEWS_DB_PASSWORD=GENERATE_SECRET
# Set true to arm the 15-minute collection scheduler. The interval is fixed.
NEWS_COLLECTION_ENABLED=false
NEWS_COLLECTION_INTERVAL_SECONDS=900
# Git revision of the collector image. It must match BUILD_INFO.json inside the
# image or the collector refuses to start.
COLLECTOR_REVISION=SET_TO_BUILT_REVISION

# --- Persian translation and summary ----------------------------------------
# Leave the provider unset to keep every Persian field pending. Nothing is
# generated without a provider; no placeholder text is ever written.
# Supported: none | openai | openai_compatible | azure_openai | anthropic
NEWS_TRANSLATION_PROVIDER=none
NEWS_TRANSLATION_API_KEY=
NEWS_TRANSLATION_BASE_URL=
NEWS_TRANSLATION_MODEL=
NEWS_TRANSLATION_TIMEOUT_SECONDS=60
NEWS_TRANSLATION_MAX_INPUT_CHARS=12000
NEWS_TRANSLATION_SLEEP_SECONDS=1.0
