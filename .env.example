# Never commit .env. Generate secrets locally; never log them.
# *_ID and OPENCTI_ADMIN_TOKEN require distinct UUIDv4 values.
# HOST, PORT and EXTERNAL_SCHEME control the web address.
# All GENERATE_SECRET values require cryptographically secure random values.
MINIO_ROOT_USER=GENERATE_SECRET
MINIO_ROOT_PASSWORD=GENERATE_SECRET
RABBITMQ_DEFAULT_USER=GENERATE_SECRET
RABBITMQ_DEFAULT_PASS=GENERATE_SECRET
SMTP_HOSTNAME=localhost
OPENSEARCH_ADMIN_PASSWORD=GENERATE_SECRET
ELASTIC_MEMORY_SIZE=4G
XTM_COMPOSER_ID=GENERATE_UUIDV4
COMPOSE_PROJECT_NAME=iran-monitor-opencti
OPENCTI_HOST=localhost
OPENCTI_PORT=8080
OPENCTI_EXTERNAL_SCHEME=http
OPENCTI_ADMIN_EMAIL=admin@iran-monitor.local
OPENCTI_ADMIN_PASSWORD=GENERATE_SECRET
OPENCTI_ADMIN_TOKEN=GENERATE_UUIDV4
OPENCTI_HEALTHCHECK_ACCESS_KEY=GENERATE_SECRET
CONNECTOR_EXPORT_FILE_STIX_ID=GENERATE_UUIDV4
CONNECTOR_EXPORT_FILE_CSV_ID=GENERATE_UUIDV4
CONNECTOR_EXPORT_FILE_TXT_ID=GENERATE_UUIDV4
CONNECTOR_IMPORT_FILE_STIX_ID=GENERATE_UUIDV4
CONNECTOR_IMPORT_DOCUMENT_ID=GENERATE_UUIDV4
CONNECTOR_IMPORT_FILE_YARA_ID=GENERATE_UUIDV4
CONNECTOR_IMPORT_EXTERNAL_REFERENCE_ID=GENERATE_UUIDV4
CONNECTOR_ANALYSIS_ID=GENERATE_UUIDV4
CONNECTOR_OPENCTI_ID=GENERATE_UUIDV4
CONNECTOR_MITRE_ID=GENERATE_UUIDV4
# Base64-encoded cryptographic 32-byte encryption key; generate locally.
OPENCTI_ENCRYPTION_KEY=GENERATE_BASE64_32_BYTES

# --- News monitor -----------------------------------------------------------
NEWS_DB_PASSWORD=GENERATE_SECRET
# Set true to arm the 15-minute collection scheduler. The interval is fixed.
NEWS_COLLECTION_ENABLED=false
NEWS_COLLECTION_INTERVAL_SECONDS=900
# Git revision of the collector image. It must match BUILD_INFO.json inside the
# image or the collector refuses to start.
COLLECTOR_REVISION=SET_TO_BUILT_REVISION

# --- Persian translation and summary ----------------------------------------
# Leave the provider unset to keep every Persian field pending. Nothing is
# generated without a provider; no placeholder text is ever written.
# Supported: none | openai | openai_compatible | azure_openai | anthropic
NEWS_TRANSLATION_PROVIDER=none
NEWS_TRANSLATION_API_KEY=
NEWS_TRANSLATION_BASE_URL=
NEWS_TRANSLATION_MODEL=
NEWS_TRANSLATION_TIMEOUT_SECONDS=60
NEWS_TRANSLATION_MAX_INPUT_CHARS=12000
NEWS_TRANSLATION_SLEEP_SECONDS=1.0

# --- AI Gateway --------------------------------------------------------------
# Provider-agnostic layer for every AI-assisted feature (translation, summary,
# classification, signal analysis, scenario generation). Leave AI_PROVIDER
# unset (or "disabled") to keep every AI-assisted field explicitly
# provider_not_configured — nothing is ever generated without a real
# provider. "deterministic" restricts callers to rule-based results only
# (a clear refusal, not a fabrication, if a caller expects a generative
# result). "local" routes to a self-hosted OpenAI-compatible endpoint (no
# cost tracked). Any other value is treated as an external_provider name:
# openai_compatible | openai | azure_openai | anthropic | openrouter.
#
# Example for OpenRouter (see docs/OPENROUTER PROVIDER ADAPTER.md):
#   AI_PROVIDER=openrouter
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_API_KEY=<your own OpenRouter key — never this project's, never committed>
#   AI_MODEL_TRANSLATION=anthropic/claude-haiku-4.5
#   AI_MODEL_SUMMARY=anthropic/claude-haiku-4.5
# Only models listed in ai_gateway.APPROVED_MODELS are accepted — an
# unlisted model is a configuration error to fix, never silently swapped.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_TRANSLATION=
AI_MODEL_SUMMARY=
AI_MODEL_CLASSIFICATION=
AI_MODEL_SIGNAL_ANALYSIS=
AI_MODEL_SCENARIO=
AI_REQUEST_TIMEOUT=60
AI_MAX_CONCURRENCY=3
# Optional. Once today's estimated spend (from ai_requests_log) reaches this
# many US dollars, the gateway fails closed with status=budget_exceeded for
# the rest of the day rather than continuing to spend. Leave empty to disable.
AI_DAILY_BUDGET_LIMIT=

# --- Local X post translation (Ollama on this machine, CPU only) -------------
# Offline batch only: nothing runs on page load or on a schedule. No cloud
# provider is ever used for this path. See docs/LOCAL OLLAMA X TRANSLATION RUNBOOK.md.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL_TRANSLATION=gemma4:e2b
# Optional digest prefix pin; a different model under the same name is refused.
OLLAMA_MODEL_DIGEST=7fbdbf8f5e45
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_THREAD=8
OLLAMA_KEEP_ALIVE=5m
X_TRANSLATION_ENABLED=false
PREVIEW_X_TRANSLATION_ENABLED=false
X_TRANSLATION_CONCURRENCY=1
X_TRANSLATION_BATCH_SIZE=1
X_TRANSLATION_TIMEOUT_SECONDS=600
X_TRANSLATION_MAX_ATTEMPTS=2
X_TRANSLATION_TEMPERATURE=0.1
X_TRANSLATION_SLEEP_SECONDS=2
# Operator token for the admin POST endpoints (>= 24 random characters).
# Empty = enqueue/run-batch are refused. Never commit a real value.
PREVIEW_SOCIAL_ADMIN_TOKEN=
