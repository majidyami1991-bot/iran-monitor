# Local AI stack (compose project iran-monitor-local-ai) — template, no secrets.
# Copy to the worktree root as .env (gitignored) and fill LOCAL_AI_DB_PASSWORD
# with a new random value before the database is created the first time:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# The password is set when the ai-db volume is first initialised; changing it
# later requires the same value the volume was created with.
#
# Nothing from the production/OpenCTI .env is needed here: this stack has its
# own database and no cloud AI provider.
LOCAL_AI_DB_PASSWORD=

# Local model (Ollama on this machine, CPU only). The digest is a pin: if the
# installed model under this name has a different digest, every AI call fails
# closed (model_digest_mismatch) until the pin is reviewed and changed.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e2b-approved-7fbdbf8f5e45
OLLAMA_MODEL_DIGEST=7fbdbf8f5e45

LOCAL_AI_NUM_CTX=4096
LOCAL_AI_TEMPERATURE=0.1
LOCAL_AI_MAX_OUTPUT_TOKENS=512
LOCAL_AI_TIMEOUT_SECONDS=900
LOCAL_AI_NUM_THREAD=8

# Batch translation runs only when an operator starts it; keep false here and
# pass -e LOCAL_TRANSLATION_ENABLED=true for one run.
LOCAL_TRANSLATION_ENABLED=false
LOCAL_TRANSLATION_SLEEP_SECONDS=2

LOCAL_AI_ASSISTANT_ENABLED=true
LOCAL_AI_ASSISTANT_RETENTION_DAYS=7
LOCAL_AI_EXPERIENCE_JOBS=true
